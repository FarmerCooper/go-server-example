{
  "$schema": "https://www.krakend.io/schema/v2.13/krakend.json",
  "version": 3,
  "port": 8080,

  "extra_config": {
    "router": {
      "auto_options": true
    },

    "security/cors": {
      "allow_origins": [
        "http://localhost:5173"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PATCH",
        "DELETE",
        "OPTIONS"
      ],
      "allow_headers": [
        "Origin",
        "Content-Type",
        "Accept",
        "Authorization"
      ],
      "expose_headers": [
        "Content-Length",
        "Content-Type"
      ],
      "allow_credentials": false,
      "max_age": "12h",
      "debug": true
    }
  },

  "endpoints": [
    {
      "endpoint": "/todos",
      "method": "GET",
      "output_encoding": "no-op",

      "backend": [
        {
          "host": [
            "http://host.docker.internal:8081"
          ],
          "url_pattern": "/internal/todos",
          "method": "GET",
          "encoding": "no-op"
        }
      ]
    },

    {
      "endpoint": "/todos",
      "method": "POST",
      "output_encoding": "no-op",

      "backend": [
        {
          "host": [
            "http://host.docker.internal:8081"
          ],
          "url_pattern": "/internal/todos",
          "method": "POST",
          "encoding": "no-op"
        }
      ]
    }
  ]
}